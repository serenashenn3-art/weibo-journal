{
  "manifest_version": 3,
  "name": "微博手账本",
  "version": "1.0.0",
  "description": "把自己的全部微博导出为手账本风格的时间线档案：HTML 手账本 + 原图文件夹 + 原始数据备份",
  "permissions": ["storage", "cookies", "downloads", "alarms", "declarativeNetRequest"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "referer",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "host_permissions": [
    "https://weibo.com/*",
    "https://*.weibo.cn/*",
    "https://*.sinaimg.cn/*",
    "https://*.sinaimg.com/*",
    "https://*.weibocdn.com/*"
  ],
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "微博手账本"
  },
  "content_scripts": [
    {
      "matches": ["https://weibo.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
